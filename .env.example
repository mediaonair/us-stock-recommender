# Gemini 계열 모델 호출에 필요한 API 키 (LiteLLM에서 사용)
GEMINI_API_KEY=

# 베이스 모델 (기본값: Gemini 계열, LiteLLM 모델명 형식)
GEMINI_MODEL=gemini/gemini-2.5-flash-lite

# 임베딩 모델 (기본값: gemini-embedding-001, LiteLLM 모델명 형식)
EMBEDDING_MODEL=gemini/gemini-embedding-001

# 추천 결과를 몇 시간마다 새로 계산할지 (기본값: 6시간)
REFRESH_INTERVAL_HOURS=6
